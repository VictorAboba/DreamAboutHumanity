{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dah.local/schemas/common.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^([a-z0-9_]{1,32}:)?[a-z0-9_]{1,32}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "short": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "amounts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ref"
      },
      "additionalProperties": {
        "type": "integer"
      }
    },
    "effect": {
      "type": "object",
      "description": "`type` (slice packs) or `effect` (TECH_AND_SETUP.md): the effect kind",
      "anyOf": [
        {
          "required": [
            "type"
          ]
        },
        {
          "required": [
            "effect"
          ]
        }
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "duration": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[0-9]+[smh]$"
        }
      ]
    },
    "lname": {
      "description": "a name, or {ru, en} (ru is shown to players)",
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "object",
          "required": [
            "ru"
          ],
          "additionalProperties": false,
          "properties": {
            "ru": {
              "$ref": "#/$defs/name"
            },
            "en": {
              "$ref": "#/$defs/name"
            }
          }
        }
      ]
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "lore": {
      "description": "inline text, or a path to a Markdown file of the pack (lore/x.md)",
      "type": "string",
      "maxLength": 1000
    },
    "system": {
      "description": "a switchable stage-3 system, or a stage-4 score source scoring.<src>: the entity is hidden while it is off (weight 0)",
      "enum": [
        "espionage",
        "conquest",
        "discoveries",
        "scoring.territory",
        "scoring.science",
        "scoring.works",
        "scoring.war",
        "scoring.intel",
        "scoring.objectives"
      ]
    }
  }
}
