{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dah.local/schemas/objective.schema.json",
  "description": "a secret objective (SCORING.md 2.5): an engine kind (registry.OBJECTIVE_KINDS) with the pack's numbers",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "points"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/lname"
    },
    "kind": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "$ref": "common.schema.json#/$defs/ref"
          }
        ]
      }
    },
    "points": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "maps": {
      "$ref": "common.schema.json#/$defs/refs"
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "requires_system": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/system"
        }
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "lore": {
      "$ref": "common.schema.json#/$defs/lore"
    }
  }
}
