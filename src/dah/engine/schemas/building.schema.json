{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dah.local/schemas/building.schema.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "cost",
    "build_turns"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/lname"
    },
    "short": {
      "$ref": "common.schema.json#/$defs/short"
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/amounts"
    },
    "build_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "effects": {
      "$ref": "common.schema.json#/$defs/effects"
    },
    "recruit": {
      "type": "boolean"
    },
    "max_per_province": {
      "const": 1
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tech": {
          "$ref": "common.schema.json#/$defs/refs"
        }
      }
    },
    "factions": {
      "$ref": "common.schema.json#/$defs/refs"
    },
    "lore": {
      "$ref": "common.schema.json#/$defs/lore"
    },
    "requires_system": {
      "$ref": "common.schema.json#/$defs/system"
    },
    "score": {
      "description": "stage 4 (SCORING.md 2.3): points to the owner while the building stands ready in its full province",
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "max_per_owner": {
      "description": "build orders refused when the seat already has this many (ready and in progress) in all its provinces",
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "allowed_types": {
      "description": "build orders only in provinces of these types (absent: any)",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    }
  }
}
