{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dah.local/schemas/map.schema.json",
  "type": "object",
  "required": ["id", "name", "max_players", "provinces", "edges", "starts"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "name": {"$ref": "common.schema.json#/$defs/name"},
    "max_players": {"type": "integer", "minimum": 1, "maximum": 16},
    "provinces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,7}$"},
          "name": {"$ref": "common.schema.json#/$defs/name"},
          "type": {"$ref": "common.schema.json#/$defs/ref"},
          "pos": {
            "description": "display position [x, y] on a 0..100 canvas (cosmetic, not part of the ruleset hash)",
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": "number", "minimum": 0, "maximum": 100}
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}
    },
    "rotation": {
      "description": "stage 5 (ABANDONED_LANDS.md 5.6): a permutation of provinces taking start i to start i+1 (fair_mirror)",
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "starts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capital"],
        "additionalProperties": false,
        "properties": {
          "capital": {"type": "string"},
          "provinces": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
